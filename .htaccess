# Protege o banco SQLite e arquivos sensíveis
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|sql|db|env|ini|md|yml|log)$">
    Require all denied
</FilesMatch>

# Bloqueia acesso direto à pasta _db
RedirectMatch 404 ^/_db(/|$)

# Cache leve para assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Servir index.html como padrão
DirectoryIndex index.html
